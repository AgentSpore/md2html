# MD2HTML runtime configuration
# Copy to .env and edit. Loaded by md2html.core.config.Settings.

# SQLite file path used by the application. Plain file path (NOT a
# sqlite:// URL) — aiosqlite.connect() takes a filesystem path.
database_url=md2html.db

# CORS allowed origins. Comma-separated. Use "*" for fully open.
cors_origins=*

# Log level passed to loguru (TRACE/DEBUG/INFO/WARNING/ERROR).
log_level=INFO
